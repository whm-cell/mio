# Run `pnpm env:init` to create private .env and .env.test (mode 600). Do not copy this template.
# Each file is complete; the test configuration never falls back to development values.

# Generated initialization settings, shown with development placeholders.
# Dev/test use separate ports, credentials, namespaces and DSH directories.
MIO_ENVIRONMENT=dev
NODE_ENV=development
MIO_HOST=127.0.0.1
MIO_PORT=4310
MIO_API_TOKEN=replace-with-a-generated-secret
MIO_AUTH_BASE_URL=http://localhost:4310
MIO_AUTH_SECRET=replace-with-a-stable-secret-at-least-32-characters
MIO_AUTH_DATABASE_URL=postgresql://mio:replace-with-app-password@127.0.0.1:55432/mio_dev
MIO_AUTH_RATE_LIMIT_BACKEND=redis
MIO_AUTH_ALLOWED_ORIGINS=[]
MIO_ALLOWED_ORIGINS=[]
MIO_REDIS_URL=redis://mio:replace-with-redis-password@127.0.0.1:56379
MIO_REDIS_NAMESPACE=dev
DSH_HOME=.runtime/dev/dsh
# A image recovery data; retained across restarts. Initialization never enables generation.
MIO_GENERATIONS_DATA_DIR=.runtime/dev/generations
# Local middleware secrets: 64 hexadecimal characters each; never passed to the app as admin settings.
MIO_LOCAL_POSTGRES_PORT=55432
MIO_LOCAL_REDIS_PORT=56379
MIO_LOCAL_POSTGRES_PASSWORD=replace-with-admin-password
MIO_LOCAL_DATABASE_PASSWORD=replace-with-app-password
MIO_LOCAL_REDIS_PASSWORD=replace-with-redis-password
# RabbitMQ: dev uses 56720/15680, test uses 56721/15681. Keep all generated values together.
MIO_LOCAL_RABBITMQ_PORT=56720
MIO_LOCAL_RABBITMQ_MANAGEMENT_PORT=15680
MIO_LOCAL_RABBITMQ_PASSWORD=replace-with-admin-password
MIO_LOCAL_RABBITMQ_A_PASSWORD=replace-with-a-password
MIO_LOCAL_RABBITMQ_B_PASSWORD=replace-with-b-password
RABBITMQ_URL=amqp://mio-dev-a:replace-with-a-password@127.0.0.1:56720/mio-dev
MIO_COMPUTE_BROKER_USER=mio-dev-a
MIO_COMPUTE_EXPECTED_RESULT_USER=mio-dev-b
MIO_LOCAL_COMPUTE_DIRECTORY=.runtime/dev/compute
MIO_LOCAL_COMPUTE_INSTANCE_ID=mio-dev-replace-with-64-generated-hex-characters
# Isolated automation account/database on the same local PostgreSQL instance; mio_regression has no access to mio_dev/mio_test.
MIO_LOCAL_REGRESSION_PASSWORD=replace-with-regression-password
MIO_TEST_DATABASE_URL=postgresql://mio_regression:replace-with-regression-password@127.0.0.1:55432/mio_regression_test

# Optional business settings; configure only the groups you need in the selected private file.
# Email/password auth is enabled by default; set false to allow only SMS/WeChat sign-in.
# MIO_AUTH_EMAIL_PASSWORD_ENABLED=false
# SMS login and binding require the complete group.
# MIO_AUTH_SMS_ENABLED=true
# MIO_TENCENT_SMS_SECRET_ID=replace-with-authorized-secret-id
# MIO_TENCENT_SMS_SECRET_KEY=replace-with-authorized-secret-key
# MIO_TENCENT_SMS_APP_ID=replace-with-sms-app-id
# MIO_TENCENT_SMS_SIGN_NAME=replace-with-approved-sign-name
# MIO_TENCENT_SMS_TEMPLATE_ID=replace-with-approved-template-id
# MIO_TENCENT_SMS_REGION=ap-guangzhou
# Optional stricter rolling budgets; values cannot exceed the documented defaults.
# MIO_AUTH_SMS_PHONE_HOUR_LIMIT=5
# MIO_AUTH_SMS_PHONE_DAY_LIMIT=10
# MIO_AUTH_SMS_IP_HOUR_LIMIT=20
# MIO_AUTH_SMS_IP_DAY_LIMIT=100
# MIO_AUTH_SMS_GLOBAL_DAY_LIMIT=1000
# WeChat Website Application login requires the complete group.
# MIO_AUTH_WECHAT_ENABLED=true
# MIO_AUTH_WECHAT_APP_ID=replace-with-website-app-id
# MIO_AUTH_WECHAT_APP_SECRET=replace-with-website-app-secret
# OneLink SSO third-party login requires the complete group when configured; runtime switch defaults to disabled in admin.
# MIO_ONELINK_SSO_ENC_KEY=replace-with-32-ascii-char-onelink-enc-key
# MIO_ONELINK_SSO_AUTHORIZE_URL=https://scenic.wanlian.cloud/authorize
# MIO_ONELINK_SSO_REGISTER_URL=https://api-test.wanlian.cloud/sso/client/register
# MIO_ONELINK_SSO_CLIENT_NAME=miioo
# MIO_ONELINK_SSO_APP_NAME=Miioo
# MIO_ONELINK_SSO_ENV=dev
# Providers and conversations each own a connection pool. Both URLs may point to the selected auth database.
# MIO_PROVIDERS_DATABASE_URL=postgresql://mio:replace-with-app-password@127.0.0.1:55432/mio_dev
# MIO_PROVIDERS_MASTER_KEY=replace-with-stable-random-32-byte-base64-key
# MIO_PROVIDERS_MASTER_KEY_ID=dev-onelink-v1
# MIO_CONVERSATIONS_DATABASE_URL=postgresql://mio:replace-with-app-password@127.0.0.1:55432/mio_dev
# MQ is provisioned independently of business enablement. W1/W2 text does not need COS.
# Configure the media database and one shared, restricted COS identity for local A and B.
# Migrate assets then generations; enable MIO_GENERATIONS_ENABLED explicitly after legacy task reconciliation.
# Generation alone needs no Worker B or RabbitMQ. Transcode uses assets then compute and MIO_COMPUTE_ENABLED.
# MIO_ASSETS_DATABASE_URL=postgresql://media-user:password@127.0.0.1:55432/media_dev
# MIO_COS_BUCKET=your-private-dev-bucket
# MIO_COS_REGION=your-region
# MIO_COS_SECRET_ID=your-authorized-secret-id
# MIO_COS_SECRET_KEY=your-authorized-secret-key
# MIO_COS_SESSION_TOKEN=your-short-lived-session-token  # optional, only with temporary credentials
# MIO_COMPUTE_ENABLED=true
# Material library: migrate assets, then materials; Unit 1 needs no model/catalog admission or COS settings.
# Enable explicitly after migrations; materials uses its own pool on MIO_ASSETS_DATABASE_URL.
# MIO_MATERIALS_ENABLED=true
# Optional real-person authentication; explicit reachable HTTPS origin, never inferred from request Host.
# MIO_MATERIALS_PUBLIC_BASE_URL=https://materials.example.com
# MIO_GENERATIONS_ENABLED=true
# Image generation requires the provider master key on A. Image RSA keys are retired after legacy reconciliation.
# Web administrator console API; migrate providers then admin, and bootstrap an admin account explicitly.
# MIO_ADMIN_ENABLED=true
# MIO_ADMIN_ALLOWED_ORIGINS=["http://localhost:4330"]
# Optional read-only RabbitMQ & Redis monitoring probes (initialize locally via `pnpm monitor:init:dev`).
# MIO_PROVIDERS_CATALOG_WHITELIST=true
# MIO_ADMIN_RABBITMQ_MONITOR_URL=http://mio-dev-monitor:replace-with-monitor-password@127.0.0.1:15680/mio-dev
# MIO_ADMIN_REDIS_MONITOR_URL=redis://mio_monitor:replace-with-monitor-password@127.0.0.1:56379

# Fixed conversation route for deployments with the provider domain disabled.
# Configure MIO_CONVERSATIONS_DATABASE_URL first.
# Set MIO_MODEL_PROVIDER and MIO_MODEL together. Only the official DeepSeek route requires MIO_MODEL_API_KEY.
# Replace the model placeholder with a real model ID for that route. BYOK never falls back to these settings.
# MIO_MODEL_PROVIDER=deepseek-official
# MIO_MODEL=replace-with-model-id-for-this-route
# MIO_MODEL_API_KEY=replace-with-authorized-deepseek-key
